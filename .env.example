# 知乎开放平台：https://developer.zhihu.com/profile
ZHIHU_ACCESS_SECRET=

# DeepSeek 开放平台：https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 推理模型的输出上限（含 reasoning tokens）
DEEPSEEK_MAX_TOKENS=8192

# 热榜抓取间隔（分钟）；热榜额度 100 次/天，建议 30
HOTROBIN_FETCH_MINUTES=30
# 每天生成上一逻辑日日报的时间，同时定义日界线（04:00）
HOTROBIN_SUMMARY_AT=04:00

# 失败通知 webhook（可选）：Server酱、Slack 或 Discord incoming webhook
HOTROBIN_NOTIFY_WEBHOOK=

# 构建后自动发布（可选）；{site}=site 目录，{time}=当前时间
# Cloudflare Worker 示例：
# HOTROBIN_DEPLOY_CMD="wrangler deploy --name hotrobin --assets {site} --compatibility-date 2026-10-29 --keep-vars"
HOTROBIN_DEPLOY_CMD=
